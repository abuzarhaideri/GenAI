# Add either Gemini or OpenAI API Key
# RECOMMENDED: Free, 14,400 req/day. Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL fallbacks:
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred (Pollinations-first)
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Fallback (rotating OpenAI keys)
OPENAI_API_KEYS=key1,key2,key3

# Backward compatible single key (optional)
OPENAI_API_KEY=your_openai_api_key_here
